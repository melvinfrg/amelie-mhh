# Supabase project → Project Settings → API. Leave empty to run in demo mode (data stays in the browser).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Claude API key for generating questions (server only, never exposed to the browser).
ANTHROPIC_API_KEY=

# Push reminder 3 months before each exam (/api/erinnerungen, daily Vercel Cron, see vercel.json).
# Einstellungen → Benachrichtigungen creates all three and the SQL line for the table cron_secret.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
